{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "OpenIDEA",
    "version":  "0.1.44",
    "identifier":  "ai.l0ng.openidea",
    "build":  {
                  "beforeDevCommand":  "pnpm dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "pnpm build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "create":  false,
                                    "title":  "OpenIDEA",
                                    "width":  1440,
                                    "height":  900,
                                    "minWidth":  800,
                                    "minHeight":  500,
                                    "titleBarStyle":  "Overlay",
                                    "hiddenTitle":  true,
                                    "backgroundColor":  "#E9EAEE",
                                    "dragDropEnabled":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; img-src \u0027self\u0027 asset: data: blob: http: https:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; font-src \u0027self\u0027 data:; connect-src ipc: http://ipc.localhost; script-src \u0027self\u0027 \u0027wasm-unsafe-eval\u0027; worker-src \u0027self\u0027 blob:; frame-src http://127.0.0.1:* openidea-plugin: http://openidea-plugin.localhost; frame-ancestors \u0027none\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "category":  "DeveloperTool",
                   "copyright":  "Copyright Â© 2026 OpenIDEA contributors",
                   "license":  "Apache-2.0",
                   "shortDescription":  "An open-source IDE inspired by IntelliJ IDEA",
                   "longDescription":  "OpenIDEA is an open-source IDE inspired by IntelliJ IDEA. Not affiliated with JetBrains.",
                   "macOS":  {
                                 "entitlements":  "./Entitlements.plist",
                                 "minimumSystemVersion":  "11.0"
                             },
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser"
                                            }
                               }
               },
    "mainBinaryName":  "openidea",
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCOUU0MUFFOUY4NzZCNkQKUldSdGE0ZWZya0dlRzNnRFJUR2loUVdNZ1BmamxkNzFoaWNPUTBsRmI0cjhxZFRqQURybkMwakEK",
                                    "endpoints":  [
                                                      "https://github.com/l0ng-ai/openidea/releases/latest/download/latest.json"
                                                  ]
                                }
                }
}
